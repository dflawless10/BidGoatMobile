"""
Example: Correct way to use SendGrid API with environment variables
This file demonstrates the pattern that should be used in main.py
"""

from dotenv import load_dotenv
import os
from sendgrid import SendGridAPIClient
from sendgrid.helpers.mail import Mail

# Load environment variables from .env file
load_dotenv()

# Get API key from environment variable
SENDGRID_API_KEY = os.getenv('SENDGRID_API_KEY')

# Validate that the API key is set
if not SENDGRID_API_KEY:
    raise ValueError("SENDGRID_API_KEY environment variable is not set. Please check your .env file.")


def send_email(to_email, subject, content):
    """
    Send an email using SendGrid
    
    Args:
        to_email (str): Recipient email address
        subject (str): Email subject
        content (str): Email body content
    """
    message = Mail(
        from_email='noreply@bidgoat.com',
        to_emails=to_email,
        subject=subject,
        html_content=content
    )
    
    try:
        # Use the validated API key from module level
        sg = SendGridAPIClient(SENDGRID_API_KEY)
        response = sg.send(message)
        print(f"Email sent! Status code: {response.status_code}")
        return response
    except Exception as e:
        print(f"Error sending email: {str(e)}")
        raise


def send_verification_email(user_email, verification_code):
    """
    Send a verification email
    
    Args:
        user_email (str): User's email address
        verification_code (str): Verification code to send
    """
    subject = "Verify your BidGoat account"
    content = f"""
    <html>
        <body>
            <h1>Welcome to BidGoat!</h1>
            <p>Your verification code is: <strong>{verification_code}</strong></p>
            <p>Please enter this code to complete your registration.</p>
        </body>
    </html>
    """
    
    # Initialize SendGrid client with validated API key
    sg = SendGridAPIClient(SENDGRID_API_KEY)
    
    message = Mail(
        from_email='verify@bidgoat.com',
        to_emails=user_email,
        subject=subject,
        html_content=content
    )
    
    try:
        response = sg.send(message)
        return response.status_code == 202
    except Exception as e:
        print(f"Failed to send verification email: {str(e)}")
        return False


def send_bid_notification(user_email, item_name, bid_amount):
    """
    Send a bid notification email
    
    Args:
        user_email (str): User's email address
        item_name (str): Name of the item
        bid_amount (float): Bid amount
    """
    # Use the validated API key from module level
    sg = SendGridAPIClient(SENDGRID_API_KEY)
    
    subject = f"New bid on {item_name}"
    content = f"""
    <html>
        <body>
            <h2>Bid Notification</h2>
            <p>A new bid of ${bid_amount} has been placed on {item_name}</p>
        </body>
    </html>
    """
    
    message = Mail(
        from_email='bids@bidgoat.com',
        to_emails=user_email,
        subject=subject,
        html_content=content
    )
    
    response = sg.send(message)
    return response


if __name__ == "__main__":
    # Example usage
    print("SendGrid API Key loaded from environment:", "Yes" if SENDGRID_API_KEY else "No")
    print("Ready to send emails!")
