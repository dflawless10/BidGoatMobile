"""
Example: Correct way to test SendGrid API with environment variables
This file demonstrates the pattern that should be used in test_sendgrid.py
"""

from dotenv import load_dotenv
import os

# Load environment variables from .env file
load_dotenv()

# Get API key from environment variable - CORRECT WAY (not hardcoded)
api_key = os.getenv('SENDGRID_API_KEY')

if not api_key:
    print("ERROR: SENDGRID_API_KEY not found in environment variables")
    print("Please ensure you have a .env file with SENDGRID_API_KEY=your_key")
    exit(1)

# Test that the API key is loaded correctly
print("✓ SendGrid API Key loaded from environment variable")
print(f"✓ API Key length: {len(api_key)} characters" if api_key else "✗ API Key is empty")

try:
    from sendgrid import SendGridAPIClient
    from sendgrid.helpers.mail import Mail
    
    # Initialize client with environment variable
    sg = SendGridAPIClient(api_key)
    
    # Create a test email
    message = Mail(
        from_email='test@bidgoat.com',
        to_emails='test@example.com',
        subject='SendGrid Test Email',
        html_content='<strong>This is a test email from BidGoat</strong>'
    )
    
    print("✓ SendGrid client initialized successfully")
    print("✓ Test email message created")
    print("✓ Configuration is correct!")
    
except ImportError:
    print("⚠ SendGrid package not installed")
    print("Run: pip install sendgrid")
except Exception as e:
    print(f"✗ Error: {str(e)}")
